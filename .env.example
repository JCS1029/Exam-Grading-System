# ==========================================================
# Automated Exam Grading & Plagiarism Detection System
# Environment Configuration Template
# DO NOT commit real API keys to version control!
# Copy this file to .env and insert your personal API keys.
# ==========================================================

# Server Settings
APP_NAME="Automated Exam Grading System"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Storage & Persistence
DATABASE_URL="sqlite:///storage/app.db"
STORAGE_ROOT="storage"

# LLM & VLM Providers (Required for live transcription & grading)
# Get Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Independent cross-check provider
OPENAI_API_KEY=""

# ----------------------------------------------------------
# Model Selections
#
# Confirm availability with a live models.list call before use; the Gemini 3.x
# line moves quickly. Pin exact version IDs and never use the "-latest"
# aliases: they re-point without notice, and a re-point midway through
# grading a cohort means some students were graded by a different model
# than others, which is indefensible on appeal.
#
# Retired / retiring, do not use:
#   gemini-1.5-pro, gemini-1.5-flash   shut down 2025-09-29
#   gemini-2.0-flash                   shut down 2026-06-01
#   gemini-2.5-pro                     retires  2026-10-16
#   gpt-4o (dated snapshots)           shut down 2026-10-23
# ----------------------------------------------------------
PRIMARY_VLM_MODEL="gemini-3.1-pro-preview"   # strongest spatial/multimodal reasoning
FAST_VLM_MODEL="gemini-3.5-flash"            # high-volume tier, escalates on low confidence
CROSSCHECK_VLM_MODEL="gpt-5.6-sol"           # independent second opinion for disagreement signal
EMBEDDING_MODEL="gemini-embedding-2"         # multimodal; handles transcripts and image crops

# Freeze the model version for the duration of a cohort's grading and record
# it on every stored grade. Set once grading begins, then leave alone.
MODEL_VERSION_FROZEN=""

# Deterministic grading: required so an appeal can be reconstructed months later.
VLM_TEMPERATURE=0

# ----------------------------------------------------------
# Confidence Bands
#
# PLACEHOLDERS ONLY. Derive these from the Phase 5 calibration curve
# (flagged vs. actually-wrong on the validation set) before real use.
# Do not ship invented thresholds — the curve is what justifies the bands.
# ----------------------------------------------------------
CONFIDENCE_HIGH_THRESHOLD=0.88    # auto-finalise; only active at deployment rung R2
CONFIDENCE_MEDIUM_THRESHOLD=0.72  # rapid confirmation queue

# Deployment posture: R0=shadow, R1=assistive, R2=selective autonomy.
# Autonomy is earned with evidence. R2 is never the starting configuration.
DEPLOYMENT_RUNG="R0"

# ----------------------------------------------------------
# Plagiarism & Collusion Settings
#
# Also placeholders: calibrate against the Phase 4 synthetic-positive and
# hard-negative sets. A false accusation is more damaging than a missed
# detection, so the hard-negative false positive rate is the binding metric.
# Output is evidence for instructor adjudication, never a verdict.
# ----------------------------------------------------------
PLAGIARISM_SIMILARITY_THRESHOLD=0.78
IDIOSYNCRATIC_ERROR_WEIGHT=2.5
