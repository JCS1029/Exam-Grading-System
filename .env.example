# ==========================================================
# Automated Exam Grading & Plagiarism Detection System
# Environment Configuration Template
# DO NOT commit real API keys to version control!
# Copy this file to .env and insert your personal API keys.
# ==========================================================

# Server Settings
APP_NAME="Automated Exam Grading System"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# LLM & VLM Providers (Required for live transcription & grading)
# Get Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# (Optional Fallback) OpenAI API key
OPENAI_API_KEY=""

# Model Selections
PRIMARY_VLM_MODEL="gemini-1.5-pro"
FAST_VLM_MODEL="gemini-1.5-flash"
FALLBACK_VLM_MODEL="gpt-4o"

# Human-in-the-Loop (HITL) Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.88    # Automatically approved
CONFIDENCE_MEDIUM_THRESHOLD=0.72  # Sent to 10-second rapid review queue

# Plagiarism & Collusion Settings
PLAGIARISM_SIMILARITY_THRESHOLD=0.78
IDIOSYNCRATIC_ERROR_WEIGHT=2.5
