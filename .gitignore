# ----------------------------------------------------------
# Student / exam private data — NEVER commit
# (scans, crops, transcripts, caches, DBs, local eval labels)
# ----------------------------------------------------------
storage/uploads/*
storage/processed/*
storage/crops/*
storage/reports/*
storage/raw/*
storage/preprocessed/*
storage/anonymized/*
storage/transcripts/*
storage/eval/*
storage/cache/*
storage/pilot_subset/*
storage/challenge_subset/*
storage/*.db
storage/app.db
storage/pseudonym_map.db

# Keep empty dir placeholders in git
!storage/uploads/.gitkeep
!storage/processed/.gitkeep
!storage/crops/.gitkeep
!storage/reports/.gitkeep
!storage/raw/.gitkeep
!storage/preprocessed/.gitkeep
!storage/anonymized/.gitkeep
!storage/transcripts/.gitkeep
!storage/eval/.gitkeep
!storage/cache/.gitkeep
!storage/pilot_subset/.gitkeep
!storage/challenge_subset/.gitkeep

# Exam PDFs / student booklet scans under docs/ (private course material)
docs/Dataset/*
docs/*.pdf
!docs/Dataset/.gitkeep
!docs/Dataset/README.md

# Non-sensitive published review memos only (no embedded student text)
!storage/reports/phase0_decision_memo.md

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/
