      "question_id": "2",
      "max_points": 10,
      "kind": "open",
      "question_text": "במפעל כלשהו מייצרים 40% מהרכיבים בפס A, ו־60% בפס B. ההסתברות שרכיב מפס A יהיה פגום היא 0.05. ההסתברות שרכיב מפס B יהיה פגום היא 0.15. מבקר איכות בחר פריט וראה שהוא תקין. מה ההסתברות שהוא יצא מ־פס A?",
      "paths": [
        {
          "path_id": "bayes",
          "description": "Bayes with total probability of a working item",
          "milestones": [
            {"id": "m1", "description": "P(from A and working) = P(A)·P(working|A)", "points": 3, "expected": "0.4*0.95", "depends_on": []},
            {"id": "m2", "description": "P(from B and working) = P(B)·P(working|B)", "points": 2, "expected": "0.6*0.85", "depends_on": []},
            {"id": "m3", "description": "P(working) by total probability", "points": 2, "expected": "m1+m2", "depends_on": ["m1", "m2"]},
            {"id": "m4", "description": "P(A | working) = P(A and working) / P(working)", "points": 3, "expected": "m1/m3", "depends_on": ["m1", "m3"]}
          ]
        },
        {
          "path_id": "complement",
          "description": "Total probability of a defective item, then complement",
          "milestones": [
            {"id": "c1", "description": "P(defective) by total probability", "points": 3, "expected": "0.4*0.05+0.6*0.15", "depends_on": []},
            {"id": "c2", "description": "P(working) = 1 - P(defective)", "points": 2, "expected": "1-c1", "depends_on": ["c1"]},
            {"id": "c3", "description": "P(from A and working)", "points": 2, "expected": "0.4*0.95", "depends_on": []},
            {"id": "c4", "description": "P(A | working)", "points": 3, "expected": "c3/c2", "depends_on": ["c3", "c2"]}
          ]
        }
      ]
    },
    {
      "question_id": "3",
      "max_points": 10,
      "kind": "open",
      "question_text": "אליס ובוב מתחרים בפגיעה במטרה. לאליס יש סיכוי 1/3 לפגוע ולבוב יש סיכוי 1/2. אליס מתחילה, והמשחק ממשיך בתורות עד לפגיעה במטרה. מה הסיכוי שאליס תנצח?",
      "paths": [
        {
          "path_id": "series",
          "description": "Sum over rounds: geometric series",
          "milestones": [
            {"id": "s1", "description": "probability that a full round (Alice then Bob) has no hit", "points": 3, "expected": "(2/3)*(1/2)", "depends_on": []},
            {"id": "s2", "description": "sum of the geometric series over rounds, 1/(1-q)", "points": 3, "expected": "1/(1-s1)", "depends_on": ["s1"]},
            {"id": "s3", "description": "P(Alice wins) = (1/3) · series sum", "points": 4, "expected": "(1/3)*s2", "depends_on": ["s2"]}
          ]
        },
        {
          "path_id": "recursion",
          "description": "First-step analysis: p = 1/3 + (2/3)(1/2)p",
          "milestones": [
            {"id": "r1", "description": "sets up the first-step / recursive equation for p", "points": 5, "expected": null, "depends_on": []},
            {"id": "r2", "description": "solves the equation for p", "points": 5, "expected": "(1/3)/(1-(2/3)*(1/2))", "depends_on": []}
          ]
        }
      ]
